# ---- Fill in YOUR private data (copy to .env for local use; set in Render dashboard for production) ----
# Comma-separated access keys. Anyone with a key can generate. Leave empty for a public (rate-limited) instance.
ACCESS_KEYS=
# Enables GET /api/v1/admin/stats. Leave empty to disable.
ADMIN_KEY=
# Branding
BRAND_NAME=MotionCraft
WATERMARK_TEXT=
# Origins allowed to call the API from other websites (comma-separated). Empty = same-origin only.
ALLOWED_ORIGINS=

# ---- Capacity & safety ----
PORT=8080
DATA_DIR=./data
WORKERS=1                 # parallel renders (1 per CPU core is a good rule)
QUEUE_MAX=50
PER_IP_ACTIVE=2
RATE_GENERATE_PER_MIN=8
RATE_GENERAL_PER_MIN=240
MAX_UPLOAD_MB=12
MAX_QUALITY=fhd           # draft | hd | fhd
RETENTION_HOURS=24
RENDER_TIMEOUT_S=1800
TRUST_PROXY_HOPS=0        # set 1 behind Render / a single reverse proxy
FFMPEG_PRESET=veryfast
